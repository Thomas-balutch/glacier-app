<!doctype html>

<html lang="fr">

<head>

  <meta charset="utf-8" />

  <meta name="viewport" content="width=device-width,initial-scale=1" />

  <title>Carte interactive des glaciers</title>


  <!-- Leaflet -->

  <link

    rel="stylesheet"

    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"

  />


  <!-- Ton CSS -->

  <link rel="stylesheet" href="./style.css" />

</head>


<body>

  <header class="header">

    <h1>Carte interactive des glaciers</h1>

    <p class="subtitle">Clique sur un glacier : la fiche et les dashboards se mettent à jour.</p>

  </header>


  <main class="container">

    <div id="map"></div>


    <section class="panel">

      <div class="card card-wide" id="glacier-card">

        <h2>Fiche glacier</h2>

        <p class="muted">Clique sur un glacier sur la carte.</p>


        <div class="info"><span class="label">Nom :</span> <span id="g-name">—</span></div>

        <div class="info"><span class="label">Pays :</span> <span id="g-country">—</span></div>
wwwwwwwwwwwwwwwwwwwwwwwwwwww
        <div class="info"><span class="label">Altitude moyenne :</span> <span id="g-alt">—</span></div>

        <div class="info"><span class="label">Surface :</span> <span id="g-area">—</span></div>

      </div>


      <div class="grid">

        <div class="card">

          <h3>Altitude (Top 10 France)</h3>

          <canvas id="chartAlt"></canvas>

        </div>


        <div class="card">

          <h3>Surface (Top 10 France)</h3>

          <canvas id="chartArea"></canvas>

        </div>


        <div class="card card-wide">

          <h3 id="lineTitle">Évolution (exemple)</h3>

          <canvas id="chartLine"></canvas>

          <p class="muted" id="lineHint"></p>

        </div>

      </div>

    </section>

  </main>


  <!-- Leaflet + Chart.js -->

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>


  <!-- Ton JS -->

  <script src="./map.js"></script>

</body>

</html>

